   "n": 1,
   "text": "Each AI taught a car. One hits the wall.",
   "start": 0.08,
   "end": 2.4
  },
  {
   "n": 2,
   "text": "Same job for all five: teach this car to drive.",
   "start": 2.59,
   "end": 5.18
  },
  {
   "n": 3,
   "text": "Each AI sets its own driving rules.",
   "start": 5.37,
   "end": 7.04
