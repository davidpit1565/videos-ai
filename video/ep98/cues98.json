   "text": "Five AIs race, one hits the wall.",
   "start": 0.08,
   "end": 1.8
  },
  {
   "n": 2,
   "text": "Each AI gets the same job: teach a car to race.",
   "start": 1.86,
   "end": 4.59
  },
  {
   "n": 3,
   "text": "Hands off. Go!",
   "start": 4.65,
   "end": 6.15
  },
  {
