 "lines": [
  {
   "n": 1,
   "text": "Your secrets aren't safe with Gemini.",
   "start": 0.1,
   "end": 2.52,
   "real": false
  },
  {
   "n": 2,
   "text": "Even the company warns you.",
   "start": 3.07,
   "end": 5.17,
   "real": false
  },
  {
   "n": 3,
   "text": "Because a real person may read your chat.",
   "start": 5.47,
   "end": 8.53,
   "real": false
  },
  {
   "n": 4,
   "text": "Not a robot. A person.",
   "start": 8.83,
   "end": 10.93,
   "real": false
  },
  {
   "n": 5,
   "text": "And they keep it a long time. Even if you delete it.",
   "start": 11.23,
   "end": 15.57,
   "real": false
  },
  {
   "n": 6,
   "text": "So here's the one rule.",
   "start": 15.87,
   "end": 17.97,
   "real": false
  },
  {
   "n": 7,
   "text": "Don't type what you'd hate for anyone to read.",
   "start": 18.27,
   "end": 21.65,
   "real": false
  },
  {
   "n": 8,
   "text": "Then switch off Keep Activity. It helps a bit.",
   "start": 21.95,
   "end": 25.33,
   "real": false
  },
  {
   "n": 9,
   "text": "Send this to a friend who tells Gemini everything.",
   "start": 25.63,
   "end": 29.01,
   "real": false
  },
  {
   "n": 10,
   "text": "Don't miss the next AI trap. Follow.",
   "start": 29.31,
   "end": 32.05,
   "real": false
  }
