{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/track",
      "schedule": "10 6 * * *"
    },
    {
      "path": "/api/health-check",
      "schedule": "10 18 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/*": false
    }
  }
}